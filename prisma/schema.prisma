generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GymStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  GYM_OWNER
  BRANCH_MANAGER
  RECEPTIONIST
  TRAINER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  FAILED
  REFUNDED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  MAINTENANCE
  SUPPLIES
  MARKETING
  OTHER
}

enum PTSessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

model Gym {
  id       String    @id @default(uuid())
  name     String
  code     String    @unique
  email    String    @unique
  phone    String?
  logo     String?
  address  String?
  city     String?
  state    String?
  country  String?
  pincode  String?
  timezone String    @default("Asia/Kolkata")
  currency String    @default("INR")
  status   GymStatus @default(ACTIVE)

  branches        Branch[]
  users           User[]
  members         Member[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  payments        Payment[]
  trainerProfiles TrainerProfile[]
  attendances     Attendance[]
  expenses        Expense[]
  workoutPlans    WorkoutPlan[]
  dietPlans       DietPlan[]
  ptPackages      PTPackage[]
  ptSessions      PTSession[]
  settings        GymSettings?
  settingsBackups GymSettingsBackup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GymSettings {
  id String @id @default(uuid())

  gymId String @unique
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  gymName                   String
  ownerName                 String
  email                     String
  phone                     String
  alternatePhone            String?
  address                   String
  city                      String
  state                     String
  country                   String
  pincode                   String
  gstNumber                 String?
  website                   String?
  googleBusinessProfileUrl  String?
  businessHours             String
  gymLogo                   String?

  primaryAccentColor String @default("#2563EB")
  secondaryColor     String @default("#0F172A")
  brandingLogo       String?
  favicon            String?

  defaultMembershipDurationDays Int     @default(90)
  defaultFreezeDays             Int     @default(7)
  allowMultipleActiveMemberships Boolean @default(false)
  autoActivateMembership         Boolean @default(true)
  membershipExpiryReminder       Boolean @default(true)
  reminderBeforeDays             Int     @default(7)
  gracePeriodAfterExpiryDays     Int     @default(3)

  currency                  String  @default("INR")
  currencySymbol            String  @default("₹")
  taxPercentage             Decimal @default(0) @db.Decimal(5, 2)
  lateFee                   Decimal @default(0) @db.Decimal(10, 2)
  receiptPrefix             String  @default("RCPT")
  invoicePrefix             String  @default("INV")
  autoGenerateReceiptNumber Boolean @default(true)

  allowMultipleCheckIns      Boolean @default(false)
  lateArrivalThresholdMins   Int     @default(15)
  workingHoursStart          String  @default("06:00")
  workingHoursEnd            String  @default("22:00")
  checkInWindowStart         String  @default("05:30")
  checkInWindowEnd           String  @default("23:00")
  attendanceAutoCloseTime    String  @default("23:59")

  whatsappNotifications  Boolean @default(false)
  smsNotifications       Boolean @default(false)
  emailNotifications     Boolean @default(true)
  renewalReminder        Boolean @default(true)
  paymentReminder        Boolean @default(true)
  birthdayWishes         Boolean @default(false)
  attendanceReminder     Boolean @default(false)

  defaultDashboard String @default("overview")
  defaultLanguage  String @default("en")
  dateFormat       String @default("DD/MM/YYYY")
  timeFormat       String @default("24h")
  timezone         String @default("Asia/Kolkata")

  requirePasswordChange  Boolean @default(false)
  sessionTimeoutMinutes  Int     @default(30)
  twoFactorAuthentication Boolean @default(false)
  loginHistoryEnabled     Boolean @default(true)

  lastBackupAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

model GymSettingsBackup {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  label    String?
  snapshot Json

  createdAt DateTime @default(now())

  @@index([gymId])
  @@index([createdAt])
}

model Branch {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name String
  code String

  email String?
  phone String?

  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  isActive Boolean @default(true)

  users        User[]
  members      Member[]
  memberships  Membership[]
  payments     Payment[]
  attendances  Attendance[]
  expenses     Expense[]
  workoutPlans WorkoutPlan[]
  dietPlans    DietPlan[]
  ptSessions   PTSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, code])
  @@index([gymId])
}

model User {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  fullName String
  email    String  @unique
  phone    String?

  password String

  role UserRole

  isActive Boolean @default(true)

  trainerProfile     TrainerProfile?
  createdAttendances Attendance[]    @relation("AttendanceCreatedBy")
  createdExpenses    Expense[]       @relation("ExpenseCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
}

model TrainerProfile {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization   String?
  experienceYears  Int?
  salary           Decimal?  @db.Decimal(10, 2)
  joiningDate      DateTime?
  certifications   String?
  bio              String?
  emergencyContact String?
  isActive         Boolean   @default(true)

  workoutPlans WorkoutPlan[]
  dietPlans    DietPlan[]
  ptSessions   PTSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([isActive])
}

model Member {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  memberCode String

  firstName String
  lastName  String?

  gender Gender

  dateOfBirth DateTime?

  phone String
  email String?

  address String?

  emergencyName  String?
  emergencyPhone String?

  joiningDate DateTime @default(now())

  status MemberStatus @default(ACTIVE)

  photo String?

  notes String?

  memberships  Membership[]
  payments     Payment[]
  attendances  Attendance[]
  workoutPlans WorkoutPlan[]
  dietPlans    DietPlan[]
  ptSessions   PTSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, memberCode])
  @@index([gymId])
  @@index([branchId])
  @@index([status])
}

model MembershipPlan {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name String

  durationInDays Int

  price Decimal @db.Decimal(10, 2)

  joiningFee Decimal @default(0) @db.Decimal(10, 2)

  description String?

  freezeDays Int @default(0)

  isActive Boolean @default(true)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

model Membership {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  amount Decimal @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  finalAmount Decimal @db.Decimal(10, 2)

  status MembershipStatus @default(ACTIVE)

  remarks String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  paymentMode PaymentMode

  paymentStatus PaymentStatus

  transactionId String?

  paymentDate DateTime @default(now())

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([memberId])
  @@index([membershipId])
  @@index([paymentStatus])
  @@index([paymentDate])
}

model Attendance {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  attendanceDate DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([memberId])
  @@index([attendanceDate])
  @@index([status])
}

model Expense {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  title         String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMode   PaymentMode
  vendor        String?
  invoiceNumber String?
  expenseDate   DateTime
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([expenseDate])
  @@index([category])
  @@index([paymentMode])
}

model WorkoutPlan {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title       String
  description String?

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([trainerProfileId])
  @@index([memberId])
  @@index([isActive])
}

model DietPlan {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title       String
  description String?

  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([trainerProfileId])
  @@index([memberId])
  @@index([isActive])
}

model PTPackage {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name String

  numberOfSessions Int

  price Decimal @db.Decimal(10, 2)

  durationInDays Int

  description String?

  isActive Boolean @default(true)

  ptSessions PTSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([isActive])
}

model PTSession {
  id String @id @default(uuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  ptPackageId String
  ptPackage   PTPackage @relation(fields: [ptPackageId], references: [id], onDelete: Cascade)

  sessionDate DateTime
  startTime   String?
  endTime     String?
  status      PTSessionStatus @default(SCHEDULED)
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([branchId])
  @@index([trainerProfileId])
  @@index([memberId])
  @@index([ptPackageId])
  @@index([sessionDate])
  @@index([status])
}
