"use client";

import { motion } from "framer-motion";
import type { PlanRevenue } from "../../revenue/mockRevenue";

type PlanBreakdownProps = {
  data: PlanRevenue[];
};

export function PlanBreakdown({ data }: PlanBreakdownProps) {
  const maxAmount = Math.max(...data.map((d) => d.amount), 1);

  return (
    <section className="rounded-[1.6rem] border border-slate-200 bg-white p-4 shadow-[0_10px_35px_rgba(15,23,42,0.06)] sm:p-5">
      <div>
        <p className="text-sm font-semibold text-slate-900">Revenue by Membership Plan</p>
        <p className="text-sm text-slate-500">Plan-wise revenue distribution</p>
      </div>

      <div className="mt-5 space-y-4">
        {data.map((plan, i) => {
          const widthPct = (plan.amount / maxAmount) * 100;
          return (
            <motion.div
              key={plan.plan}
              initial={{ opacity: 0, x: -8 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 0.25, delay: i * 0.06, ease: "easeOut" }}
            >
              <div className="flex items-center justify-between text-sm">
                <span className="font-semibold text-slate-800">{plan.plan}</span>
                <span className="font-medium text-slate-600">
                  ₹{(plan.amount / 100000).toFixed(1)}L · {plan.count} members
                </span>
              </div>
              <div className="mt-1.5 h-3 w-full rounded-full bg-slate-100 overflow-hidden">
                <motion.div
                  initial={{ width: 0 }}
                  animate={{ width: `${widthPct}%` }}
                  transition={{ duration: 0.4, delay: i * 0.06, ease: "easeOut" }}
                  className={`h-full rounded-full ${plan.color}`}
                />
              </div>
            </motion.div>
          );
        })}
      </div>
    </section>
  );
}